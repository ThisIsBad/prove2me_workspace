import Mathlib
import Definitions.Def_BanditTrajectory

namespace RobbinsSeqDesign.ForcedSampling

open MeasureTheory ProbabilityTheory BanditAlgorithm

/-- The sum `S_n = x₁ + ⋯ + x_n` of the first `n` observations of a trajectory
(Robbins 1952, p. 529); trajectory coordinate `t` is the paper's draw `t + 1`. -/
def partialSum (n : ℕ) (ω : ℕ → Fin 2 × ℝ) : ℝ :=
  ∑ t ∈ Finset.range n, (ω t).2

/-- The loss (Robbins 1952, Section 2, Eq. (9), p. 531)
`L_n(A, B, R) = max(α, β) − E(S_n / n)`, where `α`, `β` are the means of the populations
A = arm `0` and B = arm `1` of `ν` and the expectation is taken under the law of the
sampling process generated by the rule `π`. -/
noncomputable def loss (ν : StochasticBandit 2) (π : BanditPolicy 2) (n : ℕ) : ℝ :=
  max (banditArmMean ν 0) (banditArmMean ν 1) -
    ∫ ω, partialSum n ω / (n : ℝ) ∂(banditTrajMeasure ν π)

end RobbinsSeqDesign.ForcedSampling
