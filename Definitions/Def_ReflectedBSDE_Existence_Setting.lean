import Mathlib
import Definitions.Def_Peng1990_SMP_Stochastic

open MeasureTheory ProbabilityTheory Set
open scoped NNReal ENNReal

namespace ReflectedBSDE.Existence

open Peng1990.SMP

variable {Ω : Type*} [mΩ : MeasurableSpace Ω]

/-- The σ-algebra generated by the `P`-null sets of `𝓕` (measurable sets of measure zero). -/
@[reducible] def nullSigma (P : Measure Ω) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {N | MeasurableSet N ∧ P N = 0}

/-- §2, p. 703: `𝓕_t`, the natural filtration of the Brownian motion `B` with the `P`-null sets of
`𝓕` adjoined, `𝓕_t = σ{B_s : s ≤ t} ∨ σ{N ∈ 𝓕 : P(N) = 0}`; in particular `𝓕_0` contains all
`P`-null sets of `𝓕`. -/
noncomputable def augmentedFiltration {d : ℕ} (P : Measure Ω) {B : ℝ≥0 → Ω → Fin d → ℝ}
    (hB : IsStdBrownian P B) : Filtration ℝ≥0 mΩ where
  seq t := brownianFiltration hB t ⊔ nullSigma P
  mono' _ _ hst := sup_le_sup_right ((brownianFiltration hB).mono hst) _
  le' t := sup_le ((brownianFiltration hB).le t)
    (MeasurableSpace.generateFrom_le fun _ hN => hN.1)

/-- The squared Euclidean norm `|z|² = Σⱼ zⱼ²` of `z ∈ ℝ^d`. -/
def euclSq {d : ℕ} (z : Fin d → ℝ) : ℝ := ∑ j, z j ^ 2

/-- The Euclidean norm `|z| = (Σⱼ zⱼ²)^{1/2}` of `z ∈ ℝ^d`. -/
noncomputable def euclNorm {d : ℕ} (z : Fin d → ℝ) : ℝ := Real.sqrt (euclSq z)

/-- `E(sup_{0≤t≤T} |X_t|²)`, in `[0, ∞]`. -/
noncomputable def supSqMoment (P : Measure Ω) (T : ℝ≥0) (X : ℝ≥0 → Ω → ℝ) : ℝ≥0∞ :=
  ∫⁻ ω, ⨆ t ∈ Iic T, ‖X t ω‖ₑ ^ 2 ∂P

/-- `𝒮²`: progressively measurable real processes `X` with `E(sup_{0≤t≤T} X_t²) < ∞`. -/
def IsS2 (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) (T : ℝ≥0) (X : ℝ≥0 → Ω → ℝ) : Prop :=
  IsStronglyProgressive 𝓕 X ∧ supSqMoment P T X < ⊤

/-- (i): the terminal value `ξ` lies in `𝕃²`, i.e. it is `𝓕_T`-measurable with `E ξ² < ∞`. -/
def IsTerminalValue (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) (T : ℝ≥0) (ξ : Ω → ℝ) : Prop :=
  StronglyMeasurable[𝓕 T] ξ ∧ ∫⁻ ω, ‖ξ ω‖ₑ ^ 2 ∂P < ⊤

/-- (ii) and (iii) with Lipschitz constant `L`: the coefficient
`f : [0, ∞[ × Ω × ℝ × ℝ^d → ℝ` satisfies `f(·, y, z) ∈ ℍ²` for every `(y, z)`, `L > 0`, and almost
surely, for all `t ∈ [0, T]`, `y, y'`, `z, z'`,
`|f(t, y, z) − f(t, y', z')| ≤ L(|y − y'| + |z − z'|)` (Euclidean norm on `ℝ^d`). -/
def IsLipschitzCoeff {d : ℕ} (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) (T : ℝ≥0) (L : ℝ)
    (f : ℝ≥0 → Ω → ℝ → (Fin d → ℝ) → ℝ) : Prop :=
  (∀ y z, L2F 𝓕 P T (fun t ω => f t ω y z)) ∧ 0 < L ∧
    ∀ᵐ ω ∂P, ∀ t ≤ T, ∀ y y' : ℝ, ∀ z z' : Fin d → ℝ,
      |f t ω y z - f t ω y' z'| ≤ L * (|y - y'| + euclNorm (z - z'))

/-- (iv) and the standing assumptions on the obstacle: `S` is progressively measurable, almost
every path is continuous on `[0, T]`, and `E(sup_{0≤t≤T} (S_t⁺)²) < ∞`. -/
def IsObstacle (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) (T : ℝ≥0) (S : ℝ≥0 → Ω → ℝ) : Prop :=
  IsStronglyProgressive 𝓕 S ∧ (∀ᵐ ω ∂P, ContinuousOn (fun t => S t ω) (Iic T)) ∧
    supSqMoment P T (fun t ω => max (S t ω) 0) < ⊤

/-- §2, pp. 703–704: the data `(ξ, f, S)` satisfy (i), (ii), (iii) with Lipschitz constant `L`,
(iv), and the standing assumption `S_T ≤ ξ` a.s. -/
structure IsStandardData {d : ℕ} (𝓕 : Filtration ℝ≥0 mΩ) (P : Measure Ω) (T : ℝ≥0) (L : ℝ)
    (ξ : Ω → ℝ) (f : ℝ≥0 → Ω → ℝ → (Fin d → ℝ) → ℝ) (S : ℝ≥0 → Ω → ℝ) : Prop where
  terminal : IsTerminalValue 𝓕 P T ξ
  coeff : IsLipschitzCoeff 𝓕 P T L f
  obstacle : IsObstacle 𝓕 P T S
  obstacle_le_terminal : ∀ᵐ ω ∂P, S T ω ≤ ξ ω

end ReflectedBSDE.Existence
