import Mathlib
import Definitions.Def_ScenarioApproach_Generalization_violation
import Definitions.Def_ScenarioApproach_Generalization_scenarioProgram
import Definitions.Def_ScenarioApproach_Generalization_supportConstraint

namespace ScenarioExact.PartOne

open ScenarioApproach.Generalization MeasureTheory

/-- The indexes of the support constraints (Definition 2.1, p. 3) of the program `P_m` with the
sampled constraints `ω 0, …, ω (m-1)`, counted at the point `θ` (in use, its solution). -/
noncomputable def supportIndexSet {d m : ℕ} {Δ : Type*} (c : EuclideanSpace ℝ (Fin d))
    (Θ : Set (EuclideanSpace ℝ (Fin d))) (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (ω : Fin m → Δ) (θ : EuclideanSpace ℝ (Fin d)) : Finset (Fin m) := by
  classical
  exact Finset.univ.filter fun i : Fin m => IsSupportConstraint c Θ Θδ ω θ i

/-- §3, PART 1, p. 8: `S_𝓘` is the set of multi-extractions `ω ∈ Δ^m` whose program `P_m`
(solved by `θs m ω`) has exactly the support constraints with indexes in `I`. -/
def S {d m : ℕ} {Δ : Type*} (c : EuclideanSpace ℝ (Fin d))
    (Θ : Set (EuclideanSpace ℝ (Fin d))) (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d)) (I : Finset (Fin m)) :
    Set (Fin m → Δ) :=
  {ω | supportIndexSet c Θ Θδ ω (θs m ω) = I}

/-- §3, PART 1, p. 8: the index set `𝓘̄ = {1, …, d}`, 0-based: the indexes `i : Fin m` with
`i < d`. -/
def Ibar (d m : ℕ) : Finset (Fin m) :=
  Finset.univ.filter fun i : Fin m => i.val < d

/-- The first `d` constraints `(δ⁽¹⁾, …, δ⁽ᵈ⁾)` of a multi-extraction of `m ≥ d` elements. -/
def firstD {d m : ℕ} {Δ : Type*} (hm : d ≤ m) (ω : Fin m → Δ) : Fin d → Δ :=
  fun i => ω (Fin.castLE hm i)

/-- §3, PART 1, p. 8: `S̃_𝓘̄` is the set of multi-extractions `ω ∈ Δ^m` such that the
constraints `δ⁽ᵈ⁺¹⁾, …, δ⁽ᵐ⁾` (0-based: the indexes `j ≥ d`) are not violated by the solution
`θs d (firstD hm ω)` generated by `δ⁽¹⁾, …, δ⁽ᵈ⁾`. -/
def Stilde {d m : ℕ} {Δ : Type*} (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d)) (hm : d ≤ m) :
    Set (Fin m → Δ) :=
  {ω | ∀ j : Fin m, d ≤ j.val → θs d (firstD hm ω) ∈ Θδ (ω j)}

/-- (3.1), p. 7: the law `F` of the violation `V(x*_d)` of the solution of the program with
`d` constraints drawn independently from `P`; its distribution function is
`F(α) = violationLaw P Θδ θs (Set.Iic α)`. -/
noncomputable def violationLaw {d : ℕ} {Δ : Type*} [MeasurableSpace Δ] (P : Measure Δ)
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d)) : Measure ℝ :=
  (Measure.pi fun _ : Fin d => P).map (fun ω => violation P Θδ (θs d ω))

end ScenarioExact.PartOne
