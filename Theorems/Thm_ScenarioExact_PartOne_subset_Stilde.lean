/-- §3, PART 1, p. 9 (claim on p. 8): `S_𝓘̄ ⊆ S̃_𝓘̄`. Deterministic: for every multi-extraction
whose support constraints are exactly the first `d`, the solution generated by the first `d`
constraints violates none of the others. -/
theorem subset_Stilde {d m : ℕ} {Δ : Type*}
    (c : EuclideanSpace ℝ (Fin d)) (Θ : Set (EuclideanSpace ℝ (Fin d)))
    (Θδ : Δ → Set (EuclideanSpace ℝ (Fin d)))
    (hΘ_convex : Convex ℝ Θ) (hΘδ_convex : ∀ δ, Convex ℝ (Θδ δ))
    (hexu : ∀ (k : ℕ) (ω : Fin k → Δ), ∃! θ, IsSolution c Θ Θδ ω θ)
    (θs : (k : ℕ) → (Fin k → Δ) → EuclideanSpace ℝ (Fin d))
    (hθs : ∀ (k : ℕ) (ω : Fin k → Δ), IsSolution c Θ Θδ ω (θs k ω))
    (hm : d ≤ m) :
    S c Θ Θδ θs (Ibar d m) ⊆ Stilde Θδ θs hm := by sorry

end ScenarioExact.PartOne

